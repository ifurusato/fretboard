      [ 'B♭', 'F',  'D♭', 'A♭', 'E♭', 'B♭' ], [ 'B',  'G♭', 'D',  'A',  'E',  'B' ],  [ 'C',  'G',  'E♭', 'B♭', 'F',  'C' ],  
