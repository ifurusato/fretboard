      [ 'E',  'B',  'G',  'D',  'A',  'E' ],  [ 'F',  'C',  'A♭', 'E♭', 'B♭', 'F' ],  [ 'G♭', 'D♭', 'A',  'E',  'B',  'G♭' ],
